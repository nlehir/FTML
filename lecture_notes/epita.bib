issn = {0706-652X, 1205-7533},
journal = {Proceedings of the 13th International Conference on Machine Learning},
pages = {148--156},
title = {{Experiments with a New Boosting Algorithm}},
url = {http://www.public.asu.edu/$\sim$jye02/CLASSES/Fall-2005/PAPERS/boosting-icml.pdf},
year = {1996}
}
@article{Bach2014,
abstract = {In this paper, we consider supervised learning problems such as logistic regression and study the stochastic gradient method with averaging, in the usual stochastic approximation setting where observations are used only once. We show that after N iterations, with a constant step-size proportional to 1=R 2 √N where N is the number of observations and R is the maximum norm of the observations, the convergence rate is always of order O(1= √N), and improves to O(R2=$\mu$N) where $\mu$ is the lowest eigenvalue of the Hessian at the global optimum (when this eigenvalue is greater than R2= √N). Since $\mu$ does not need to be known in advance, this shows that averaged stochastic gradient is adaptive to unknown local strong convexity of the objective function. Our proof relies on the generalized selfconcordance properties of the logistic loss and thus extends to all generalized linear models with uniformly bounded features. {\textcopyright} 2014 Francis Bach.},
archivePrefix = {arXiv},
arxivId = {1303.6149},
author = {Bach, Francis},
eprint = {1303.6149},
file = {:Users/nico/Desktop/enseignement/epita/doc/SGA/SGA LR.pdf:pdf},
issn = {15337928},
journal = {Journal of Machine Learning Research},
keywords = {Logistic regression,Self-concordance,Stochastic approximation},
pages = {595--627},
title = {{Adaptivity of averaged stochastic gradient descent to local strong convexity for logistic regression}},
volume = {15},
year = {2014}
}
